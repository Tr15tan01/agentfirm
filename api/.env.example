# ── AgentFirm API ──────────────────────────────────────────────
AGENTFIRM_ENV=development
# App connects as a NON-owner role so PostgreSQL row-level security applies.
AGENTFIRM_DATABASE_URL=postgresql+asyncpg://agentfirm_app:app_dev_pw@localhost:5432/agentfirm
# Migrations run as the schema owner.
AGENTFIRM_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://agentfirm_owner:owner_dev_pw@localhost:5432/agentfirm
AGENTFIRM_REDIS_URL=redis://localhost:6379/0
# Ed25519 private key (PEM) for access tokens. Dev generates one under .keys/ if unset.
AGENTFIRM_JWT_PRIVATE_KEY=
AGENTFIRM_JWT_ISSUER=agentfirm-api
AGENTFIRM_JWT_AUDIENCE=agentfirm
# 32-byte base64 key that wraps provider API keys (AES-256-GCM). Dev generates one if unset.
AGENTFIRM_MASTER_KEY=
AGENTFIRM_CORS_ORIGINS=["http://localhost:3000"]
