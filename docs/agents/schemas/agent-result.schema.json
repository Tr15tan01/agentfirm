{
  "$defs": {
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retriable": {
          "title": "Retriable",
          "type": "boolean"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        }
      },
      "required": [
        "code",
        "message",
        "retriable"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "accessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed At"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "status": {
          "enum": [
            "verified",
            "assumption",
            "estimate",
            "speculative"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "status"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ContextPack": {
      "additionalProperties": false,
      "properties": {
        "conversation_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Summary"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileRef"
          },
          "title": "Files",
          "type": "array"
        },
        "memory": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Memory",
          "type": "object"
        },
        "prior_results": {
          "items": {
            "$ref": "#/$defs/SubtaskResultRef"
          },
          "title": "Prior Results",
          "type": "array"
        },
        "project_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "untrusted": {
          "items": {
            "$ref": "#/$defs/UntrustedContent"
          },
          "title": "Untrusted",
          "type": "array"
        }
      },
      "title": "ContextPack",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_input",
        "missing_context",
        "tool_error",
        "tool_timeout",
        "model_error",
        "model_unavailable",
        "budget_exceeded",
        "permission_denied",
        "approval_rejected",
        "approval_expired",
        "policy_violation",
        "unsafe_content",
        "upstream_data_invalid",
        "cancelled",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "HandoffRequest": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "context": {
          "$ref": "#/$defs/ContextPack"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "to_agent": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "To Agent",
          "type": "string"
        }
      },
      "required": [
        "to_agent",
        "objective",
        "reason"
      ],
      "title": "HandoffRequest",
      "type": "object"
    },
    "SubtaskResultRef": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "pattern": "^[a-z][a-z0-9_]{1,47}$",
          "title": "Agent",
          "type": "string"
        },
        "artifact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "agent",
        "summary"
      ],
      "title": "SubtaskResultRef",
      "type": "object"
    },
    "UntrustedContent": {
      "additionalProperties": false,
      "description": "Wrapper for anything not written by the requesting user (web pages, files, tool\noutput, other agents' raw results). The engine renders it inside explicit data\ndelimiters; it can never grant permissions or change the plan's tool set.",
      "properties": {
        "content": {
          "maxLength": 200000,
          "title": "Content",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "content"
      ],
      "title": "UntrustedContent",
      "type": "object"
    },
    "UsageSummary": {
      "additionalProperties": false,
      "properties": {
        "credits": {
          "default": 0,
          "title": "Credits",
          "type": "integer"
        },
        "duration_ms": {
          "default": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "UsageSummary",
      "type": "object"
    }
  },
  "$id": "https://agentfirm.app/schemas/agent-result.json",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "handoffs": {
      "items": {
        "$ref": "#/$defs/HandoffRequest"
      },
      "title": "Handoffs",
      "type": "array"
    },
    "quality": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Quality",
      "type": "object"
    },
    "questions": {
      "description": "Populated when status = needs_input",
      "items": {
        "type": "string"
      },
      "title": "Questions",
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "needs_input",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "description": "Markdown answer shown to the user",
      "title": "Summary",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/UsageSummary"
    }
  },
  "required": [
    "execution_id",
    "status",
    "summary"
  ],
  "title": "AgentResult",
  "type": "object"
}
