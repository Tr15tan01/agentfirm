{
 "title": "AgentFirm \u2014 production",
 "uid": "agentfirm-prod",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests / s by status",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(agentfirm_http_requests_total[5m]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "API p95 latency by route",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(agentfirm_http_request_duration_seconds_bucket{route!~\".*/stream\"}[5m])))"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "5xx ratio",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(agentfirm_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(agentfirm_http_requests_total[5m])), 0.001)"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Executions by status",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "agentfirm_executions"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Oldest queued task (s)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "agentfirm_queue_oldest_seconds"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Worker turns by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(agentfirm_worker_runs_total[5m]))"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Model calls by provider",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, outcome) (rate(agentfirm_model_calls_total[5m]))"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Credits charged / h",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(agentfirm_credits_charged_total[1h]))"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tool calls by status",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(agentfirm_tool_calls_total[5m]))"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Paddle webhooks",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (increase(agentfirm_billing_webhooks_total[1h]))"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "CPU busy",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Memory available",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemAvailable_bytes"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Disk free",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 48
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/host\"}"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Postgres connections",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 48
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(pg_stat_activity_count)"
    }
   ]
  }
 ]
}