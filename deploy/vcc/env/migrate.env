# agentfirm-migrate — runs database migrations and publishes agent versions during its build.
# The ONLY application that holds the database owner password.
AGENTFIRM_ENV=production
AGENTFIRM_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://agentfirm_owner:${OWNER_PW}@127.0.0.1:5432/agentfirm
# Used by the VPS Control Center backup plan (PostgreSQL dump, variable name AGENTFIRM_BACKUP_DATABASE_URL).
AGENTFIRM_BACKUP_DATABASE_URL=postgresql://agentfirm_owner:${OWNER_PW}@127.0.0.1:5432/agentfirm
