# agentfirm-web — Next.js. Holds no secrets; talks to the API over 127.0.0.1.
AGENTFIRM_API_URL=http://127.0.0.1:${API_PORT}
NEXT_PUBLIC_AGENTFIRM_API=http
NEXT_PUBLIC_AGENTFIRM_AUTH=api
NEXT_TELEMETRY_DISABLED=1
# When Paddle is ready (read at build time: redeploy the web app after changing these):
# NEXT_PUBLIC_PADDLE_ENV=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
