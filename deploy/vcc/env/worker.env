# agentfirm-worker — runs agent tasks. Same as the API minus what only the API needs (token signing key, CORS, metrics token).
AGENTFIRM_ENV=production
AGENTFIRM_DATABASE_URL=postgresql+asyncpg://agentfirm_app:${APP_PW}@127.0.0.1:5432/agentfirm
AGENTFIRM_REDIS_URL=redis://:${REDIS_PW}@127.0.0.1:6379/0
AGENTFIRM_MASTER_KEY=${MASTER_KEY}
AGENTFIRM_GATEWAY_MODE=live
AGENTFIRM_WEB_MODE=live
AGENTFIRM_CONNECTOR_MODE=live
# No Docker on this server: the Engineer agent's "run tests" step reports that it is unavailable.
AGENTFIRM_SANDBOX_BACKEND=disabled
AGENTFIRM_LOG_FORMAT=json
AGENTFIRM_DB_POOL_SIZE=10
AGENTFIRM_DB_MAX_OVERFLOW=5

# Agent output files (required): Cloudflare R2 bucket and an API token limited to that bucket.
AGENTFIRM_ARTIFACT_STORE=r2
AGENTFIRM_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AGENTFIRM_R2_BUCKET=agentfirm-artifacts
AGENTFIRM_R2_ACCESS_KEY_ID=CHANGE_ME
AGENTFIRM_R2_SECRET_ACCESS_KEY=CHANGE_ME

# Web search for the Research agent. Without a Brave key, set AGENTFIRM_SEARCH_PROVIDER=none.
AGENTFIRM_SEARCH_PROVIDER=brave
AGENTFIRM_BRAVE_API_KEY=CHANGE_ME

# Billing: off until you have set up Paddle (see the guide). Free plan and admin credit grants still work.
AGENTFIRM_PADDLE_MODE=disabled
AGENTFIRM_PADDLE_CHECKOUT_URL=https://${DOMAIN}/billing/checkout
# When Paddle is ready, change the mode to live and add:
# AGENTFIRM_PADDLE_ENVIRONMENT=sandbox
# AGENTFIRM_PADDLE_API_KEY=pdl_...
# AGENTFIRM_PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

AGENTFIRM_WORKER_CONCURRENCY=4
