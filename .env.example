# Copy to .env and fill in. Generate keys with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; print(K.generate().private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption()).decode())"
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
POSTGRES_PASSWORD=
AGENTFIRM_OWNER_PASSWORD=
AGENTFIRM_APP_PASSWORD=
AGENTFIRM_JWT_PRIVATE_KEY=
AGENTFIRM_MASTER_KEY=
PUBLIC_WEB_ORIGIN=http://localhost:3000

# ── Agent runtime (Phase 4a) ─────────────────────────────────────────────────
# live = call real providers (keys are set per provider by a super-admin, encrypted in the DB).
# simulated / fixture are for development, CI and evals only; production refuses to start with them.
AGENTFIRM_GATEWAY_MODE=live
AGENTFIRM_WEB_MODE=live
AGENTFIRM_BRAVE_API_KEY=
# Artifacts: local (dev) or r2 (production). R2 needs the AGENTFIRM_R2_* settings.
AGENTFIRM_ARTIFACT_STORE=r2
AGENTFIRM_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
AGENTFIRM_R2_ACCESS_KEY_ID=
AGENTFIRM_R2_SECRET_ACCESS_KEY=
AGENTFIRM_R2_BUCKET=
AGENTFIRM_WORKER_CONCURRENCY=4

# ── Connectors & sandbox (Phase 4b) ──────────────────────────────────────────
# live = real GitHub / webhooks / SMTP / GN7T, configured per organisation in Settings → Integrations.
# fixture = deterministic fake world for dev/CI/evals; production refuses it.
AGENTFIRM_CONNECTOR_MODE=live
# docker needs a dedicated sandbox host (never mount the host Docker socket); fixture/disabled otherwise.
AGENTFIRM_SANDBOX_BACKEND=disabled
# The web app is built against the live API (baked in at build time); "mock" = demo data.
NEXT_PUBLIC_AGENTFIRM_API=http

# ── Billing: Paddle Billing (Phase 6) ────────────────────────────────────────
# live = real Paddle; fixture = simulated checkout + signed webhooks (dev/demo, refused in production);
# disabled = free plan and admin grants only.
AGENTFIRM_PADDLE_MODE=disabled
AGENTFIRM_PADDLE_ENVIRONMENT=sandbox
AGENTFIRM_PADDLE_API_KEY=
# Paddle > Developer tools > Notifications: destination https://<api-host>/v1/billing/paddle/webhook
AGENTFIRM_PADDLE_WEBHOOK_SECRET=
# Approved default payment link (Paddle > Checkout settings): our page that loads Paddle.js
AGENTFIRM_PADDLE_CHECKOUT_URL=https://app.example.com/billing/checkout
# Browser side (client-side token, safe to expose; built into the web app)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ── Production (deploy/docker-compose.prod.yml, Phase 7) ─────────────────────
# Put these in deploy/.env.production ON THE SERVER ONLY (chmod 600, owner deploy). Never commit it.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
REGISTRY=ghcr.io/your-org
# Comma/space separated CIDRs allowed to reach /admin/* (super-admin pages). Your office/VPN IPs.
ADMIN_ALLOW_CIDRS=203.0.113.10/32
# Bearer token Prometheus uses to scrape the API's /metrics (openssl rand -hex 32). /metrics is 404 without it.
AGENTFIRM_METRICS_TOKEN=
# Read-only role (pg_monitor) used by postgres-exporter; created by infra/postgres/init.sh.
AGENTFIRM_MONITOR_PASSWORD=
AGENTFIRM_LOG_FORMAT=json
# Backups: age PUBLIC key only on the server (age-keygen; keep the private key offline, e.g. password manager + paper).
BACKUP_AGE_RECIPIENT=age1...
BACKUP_R2_BUCKET=agentfirm-backups
# R2 token scoped to the backup bucket only (Object Read & Write), separate from the artifact token.
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Dead-man switch (e.g. healthchecks.io): pinged after each successful backup; alerts you if pings stop.
BACKUP_PING_URL=
GRAFANA_ADMIN_PASSWORD=
